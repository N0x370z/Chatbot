# Copia a .env y rellena los valores.
# cp .env.example .env

TELEGRAM_BOT_TOKEN=tu_token_aqui
ADMIN_USER_ID=0
MAX_FILE_SIZE_MB=50
DOWNLOAD_PATH=./downloads
INCOMING_FILES_PATH=/data/incoming
PROCESSED_FILES_PATH=/data/processed
# Telegram no deja a los bots descargar archivos de más de 20 MB: por encima
# de ese valor no tiene efecto.
MAX_UPLOAD_SIZE_MB=20
# Calibre (opcional). Si está vacío, no se agrega a la biblioteca automáticamente.
CALIBRE_LIBRARY_PATH=
WORKER_POLL_INTERVAL_SEC=1.0
LOG_LEVEL=INFO
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_REQUESTS=10
# Para uso personal, 10 requests/min es razonable

# Lista blanca de usuarios (IDs separados por comas).
# Si está vacío, cualquier usuario puede usar el bot.
# El ADMIN_USER_ID siempre está permitido.
# Ejemplo: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# API de libros propia (opcional). Si se define, pasa a ser la fuente por defecto de /libro;
# si está vacía se usa Open Library (y el resto de fuentes públicas como respaldo).
# Ver contrato en bot/services/books_api.py
BOOKS_API_BASE_URL=
BOOKS_API_KEY=
BOOKS_API_SEARCH_PATH=books/search
BOOKS_API_DOWNLOAD_PATH=books/{id}/download
BOOKS_API_QUERY_PARAM=q
BOOKS_API_TIMEOUT_SEC=60
BOOKS_API_MAX_RESULTS=8

# Cabecera y prefijo del API key para peticiones de libros.
# BOOKS_API_KEY_HEADER=Authorization
# BOOKS_API_KEY_PREFIX=Bearer

# Verificación de certificados SSL para peticiones HTTP salientes.
# Poner false solo en entornos de desarrollo con certificados self-signed.
SSL_VERIFY=true
